start = first:word rest:("," next:word { return pegtool_value_clone(next); })* !. {
    PegtoolValue values = pegtool_value_array();
    size_t index;
    if (!pegtool_value_array_push(&values, pegtool_value_clone(first))) {
        pegtool_value_free(&values);
        return pegtool_value_null();
    }
    if (rest != NULL && rest->type == PEGTOOL_VALUE_ARRAY) {
        for (index = 0; index < rest->as.array.length; index++) {
            if (!pegtool_value_array_push(&values, pegtool_value_clone(&rest->as.array.items[index]))) {
                pegtool_value_free(&values);
                return pegtool_value_null();
            }
        }
    }
    return values;
}

word = [\p{L}]+ { return pegtool_value_string_n(c->text, c->text_length); }
