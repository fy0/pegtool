{
// Package json parses JSON as defined by [1].
//
// [1]: http://www.ecma-international.org/publications/files/ECMA-ST/ECMA-404.pdf
package json

type ParserCustomData struct{}

type Option = option

func Memoize(enabled bool) Option {
    return memoized(enabled)
}

func Parse(filename string, data []byte, opts ...Option) (any, error) {
    return parse(filename, data, opts...)
}

func ParseFile(filename string, opts ...Option) (any, error) {
    data, err := os.ReadFile(filename)
    if err != nil {
        return nil, err
    }
    return Parse(filename, data, opts...)
}

func ParseReader(filename string, reader io.Reader, opts ...Option) (any, error) {
    data, err := io.ReadAll(reader)
    if err != nil {
        return nil, err
    }
    return Parse(filename, data, opts...)
}

func toAnySlice(v any) []any {
    if v == nil {
        return nil
    }
    return v.([]any)
}
}

JSON ← _ val:Value EOF {
    return val
}

Value ← val:( Object / Array / Number / String / Bool / Null ) _ {
    return val
}

Object ← '{' _ members:( first:Member rest:( ',' _ member:Member { return member } )* { return []any{first, rest} } )? '}' {
    res := make(map[string]any)
    if members == nil {
        return res
    }
    values := members.([]any)
    pair := values[0].([]any)
    res[pair[0].(string)] = pair[1]
    for _, item := range toAnySlice(values[1]) {
        pair = item.([]any)
        res[pair[0].(string)] = pair[1]
    }
    return res
}

Member ← key:String _ ':' _ value:Value {
    return []any{key, value}
}

Array ← '[' _ values:( first:( value:Value { return []any{value} } ) rest:( ',' _ value:Value { return []any{value} } )* { return []any{first, rest} } )? ']' {
    res := []any{}
    if values == nil {
        return res
    }
    items := values.([]any)
    res = append(res, items[0].([]any)[0])
    for _, item := range toAnySlice(items[1]) {
        res = append(res, item.([]any)[0])
    }
    return res
}

Number ← '-'? Integer ( '.' DecimalDigit+ )? Exponent? {
    // JSON numbers have the same syntax as Go's, and are parseable using
    // strconv.
    value, err := strconv.ParseFloat(string(c.text), 64)
    if err != nil {
        p.addErr(err)
        return nil
    }
    return value
}

Integer ← '0' / NonZeroDecimalDigit DecimalDigit*

Exponent ← 'e'i [+-]? DecimalDigit+

String ← '"' ( !EscapedChar . / '\\' EscapeSequence )* '"' {
    c.text = bytes.Replace(c.text, []byte(`\/`), []byte(`/`), -1)
    value, err := strconv.Unquote(string(c.text))
    if err != nil {
        p.addErr(err)
        return nil
    }
    return value
}

EscapedChar ← [\x00-\x1f"\\]

EscapeSequence ← SingleCharEscape / UnicodeEscape

SingleCharEscape ← ["\\/bfnrt]

UnicodeEscape ← 'u' HexDigit HexDigit HexDigit HexDigit

DecimalDigit ← [0-9]

NonZeroDecimalDigit ← [1-9]

HexDigit ← [0-9a-f]i

Bool ← "true" { return true } / "false" { return false }

Null ← "null" { return nil }

_ "whitespace" ← [ \t\r\n]*

EOF ← !.
