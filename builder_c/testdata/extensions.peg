{
{{ if eq .Target "c" }}
#define PEGTOOL_EXTENSION_TARGET_C 1
{{ else }}
#error incorrect target template value
{{ end }}
}

start <- predicateAnd

predicateAnd <- &{ return 1; } "a" !.

predicateNot <- !{ return 0; } "b" !.

codeProbe <- *{ return pegtool_value_null(); } !.

recoveryProbe <- %{fallback} //{fallback} "x" !.

actionProbe <- value:<"x"> !. { return pegtool_value_clone(value); }

keywordLabel <- typedef:<"x"> !. { return pegtool_value_clone(_pegtool_label_typedef); }

receiverLabel <- c:<"x"> !. { return pegtool_value_clone(_pegtool_label_c); }

parserLabel <- p:<"x"> !. { return pegtool_value_clone(_pegtool_label_p); }
